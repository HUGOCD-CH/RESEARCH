# Optional: override the EWS server hostname.
# Default is webmail.medtronic.com — only change this if your company uses a different host.
EWS_SERVER=webmail.medtronic.com

# Generate a random secret key and paste it here:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-string
