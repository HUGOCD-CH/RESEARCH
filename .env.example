# Get AZURE_CLIENT_ID from the Azure portal (see README for instructions).
# No IT approval needed — you register this app yourself with your own Microsoft account.
AZURE_CLIENT_ID=your-application-client-id-here

# "organizations" restricts sign-in to work/school accounts only (recommended for Medtronic).
# Use "common" if you also want to allow personal Microsoft accounts.
AZURE_TENANT_ID=organizations

# Generate a random secret key and paste it here:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-string
