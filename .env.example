# Copy this file to .env and fill in your values.
# Get AZURE_CLIENT_ID from the Azure portal (see README.md for step-by-step instructions).

AZURE_CLIENT_ID=your-application-client-id-here

# Use "common" to support both personal Outlook.com and work/school Microsoft 365 accounts.
# Replace with your specific tenant ID if you only want to allow your organisation's accounts.
AZURE_TENANT_ID=common

# Generate a random secret key and paste it here:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-string
